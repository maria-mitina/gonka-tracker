          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  epoch_id AS \"Epoch\",\n  MIN(block_height) AS \"Start Height\",\n  MAX(block_height) AS \"End Height\",\n  MAX(block_height) - MIN(block_height) AS \"Blocks in Epoch\",\n  MIN(time) AS \"Epoch Start\",\n  MAX(time) AS \"Epoch End\"\nFROM network_metrics\nWHERE $__timeFilter(time)\nGROUP BY epoch_id\nORDER BY epoch_id DESC",
