    {
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "type": "timeseries",
      "title": "Block Height Over Time",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "name": "PostgreSQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  time AS \"time\",\n  block_height AS \"Block Height\"\nFROM network_metrics\nWHERE $__timeFilter(time)\nORDER BY time",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "postgres",
            "name": "PostgreSQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  MAX(block_height) - MIN(block_height) AS \"Height Change\"\nFROM network_metrics\nWHERE time > NOW() - INTERVAL '5 minutes'",
          "refId": "B",
          "hide": true
        }
      ],
      "alert": {
        "id": 1,
        "uid": "block-height-stalled",
        "name": "Block Height Growth Stopped",
        "message": "Block height has not increased in the last 5 minutes. The chain may be stalled.",
        "frequency": "30s",
        "conditions": [
          {
            "id": 1,
            "query": {
              "datasourceUid": "PostgreSQL",
              "model": {
                "datasource": {
                  "type": "postgres",
                  "name": "PostgreSQL"
                },
                "editorMode": "code",
                "format": "table",
                "rawQuery": true,
                "rawSql": "SELECT\n  (SELECT MAX(block_height) FROM network_metrics WHERE time > NOW() - INTERVAL '1 minute') - \n  (SELECT MAX(block_height) FROM network_metrics WHERE time > NOW() - INTERVAL '5 minutes' AND time <= NOW() - INTERVAL '4 minutes') AS \"Height Change\"",
                "refId": "B"
              },
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              }
            },
            "reducer": {
              "params": [],
              "type": "last"
            },
            "evaluator": {
              "params": [
                0
              ],
              "type": "lte"
            },
            "operator": {
              "type": "and"
            }
          }
        ],
        "executionErrorState": "alerting",
        "for": "2m",
        "noDataState": "no_data",
        "notifications": []
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "",
