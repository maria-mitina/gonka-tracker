    {
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "type": "timeseries",
      "title": "Block Rate (Blocks per Minute)",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "name": "PostgreSQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
            "rawSql": "SELECT\n  time_bucket('1 minute', time) AS \"time\",\n  CASE\n    WHEN EXTRACT(EPOCH FROM (MAX(time) - MIN(time))) > 0\n    THEN (MAX(block_height) - MIN(block_height)) / EXTRACT(EPOCH FROM (MAX(time) - MIN(time))) * 60\n    ELSE 0\n  END AS \"Blocks per Minute\"\nFROM network_metrics\nWHERE $__timeFilter(time)\nGROUP BY time_bucket('1 minute', time)\nORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
